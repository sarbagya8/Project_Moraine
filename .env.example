NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used in Rescue Passport links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication keys. Generate long random values; never expose them in browser code.
DEVICE_API_KEY=
ADMIN_API_KEY=

# Portal sessions (server only)
AUTHORITY_USERNAME=
# Generate with: npm run auth:hash-password
# Format: scrypt:<32-character-salt-hex>:<128-character-derived-key-hex>
AUTHORITY_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800

# Production-safe default. Enable only for an explicit local demo run.
DEMO_MODE=false

# Official Meta WhatsApp Cloud API (server only)
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
# Fixed prototype recipient used by live SOS and the controlled smoke test.
WHATSAPP_RECIPIENT_NUMBER=97798XXXXXXXX
WHATSAPP_TEMPLATE_NAME=argus_sos_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TIMEOUT_MS=10000

# Freshness, cooldowns, and request limits
LOCATION_STALE_SECONDS=120
READING_STALE_SECONDS=300
DEVICE_ONLINE_SECONDS=120
DEVICE_OFFLINE_SECONDS=600
SOS_COOLDOWN_SECONDS=30
NOTIFICATION_RETRY_COOLDOWN_SECONDS=60
MAX_JSON_BODY_BYTES=32768
