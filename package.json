{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "clean:build": "node scripts/clean-build-files.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "seed:demo:active-sos": "node scripts/seed-demo-data.mjs --active-sos",
    "seed:demo:reset": "node scripts/seed-demo-data.mjs --reset",
    "pretypecheck": "npm run clean:build",
    "prebuild": "npm run clean:build",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "leaflet": "^1.9.4",
    "next": "16.2.11",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
